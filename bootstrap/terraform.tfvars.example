# Copy to terraform.tfvars and fill in. Nothing here is secret, so it's fine to commit.
account_id  = "123456789012"
region      = "ap-south-1"
github_org  = "your-org"  # exact case as on GitHub
github_repo = "your-repo" # exact case as on GitHub

# Using an Identity Center permission set other than "AdministratorAccess"? List it here,
# otherwise you'll lock yourself out of the state bucket:
# admin_principal_arn_patterns = [
#   "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/*AWSReservedSSO_YourPermissionSet_*",
# ]
#
# Running as an IAM user instead of SSO (e.g. terraform-user)? Then you MUST set it to your user ARN:
# admin_principal_arn_patterns = ["arn:aws:iam::123456789012:user/terraform-user"]

# GitHub Free + private repo? Environments aren't available there, so set this to false.
# use_github_environment = false
